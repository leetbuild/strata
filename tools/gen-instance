#!/usr/bin/env python3
"""Generates a synthetic MO2 instance for tests (docs/DESIGN.md, "Oracle checks").

usage: gen-instance <target folder> [--files N]

The instance is small but mean: names that differ only by case, deep trees, unicode,
separators nested five deep, an empty mod, .mohidden files, .git folders, Root folders,
a mod the list doesn't know, a listed mod without a folder, a backup, a file over a folder
and a folder over a file. `--files N` adds N more plain files spread over the mods.
Everything is deterministic: the same arguments give the same bytes.
"""
import argparse
import os
import struct
import sys

HEADER = "# This file was automatically generated by Mod Organizer.\r\n"


def put(path, text=""):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="") as f:
        f.write(text)


def plugin(flags=0, masters=(), records=1):
    """The bytes of a minimal Skyrim SE plugin: a TES4 record (form version 44) with HEDR,
    CNAM and one MAST + DATA per master. flags: 1 = master, 0x200 = light."""
    def field(kind, body):
        return kind + struct.pack("<H", len(body)) + body
    body = field(b"HEDR", struct.pack("<fII", 1.71, records, 0x800)) + field(b"CNAM", b"gen-instance\0")
    for m in masters:
        body += field(b"MAST", m.encode() + b"\0") + field(b"DATA", bytes(8))
    return b"TES4" + struct.pack("<IIIIHH", len(body), flags, 0, 0, 44, 0) + body


# Plugin files with real headers (the rest of the files hold their own path as text).
# Cases for oracle check 4: masters by flag, extension and both, a light-flagged .esp, an .esp
# with the master flag listed among plain ones, a plugin listed above its master, a missing
# master, an unreadable plugin, a plugin no list names, one name in two cases.
PLUGINS = {
    "Data/Skyrim.esm": plugin(1),
    "Data/Update.esm": plugin(1, ["Skyrim.esm"]),
    "b.esm": plugin(1, ["Skyrim.esm"]),
    "a.esp": plugin(0, ["Skyrim.esm", "b.esm"]),
    "c.esl": plugin(0x201, ["Skyrim.esm"]),
    "d.esp": plugin(0x200, ["Skyrim.esm"]),
    "e.esp": plugin(1, ["Skyrim.esm"]),
    "f.esp": plugin(0, ["Skyrim.esm", "Missing.esm"]),
    "h.esp": plugin(0, ["i.esp"]),
    "i.esp": plugin(0, []),
    "late.esp": plugin(0, ["Update.esm"]),
    "visible.esp": plugin(0, ["Skyrim.esm"], records=0),
    "case.esp": plugin(0, []),
    "CASE.ESP": plugin(1, []),
}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("target")
    ap.add_argument("--files", type=int, default=0)
    args = ap.parse_args()
    root = os.path.abspath(args.target)
    if os.path.exists(root) and os.listdir(root):
        sys.exit(f"{root} exists and is not empty")

    game = os.path.join(root, "Game Root")
    wine = "Z:" + game.replace("/", "\\\\")
    put(os.path.join(root, "ModOrganizer.ini"),
        "[General]\r\ngameName=Skyrim Special Edition\r\nselected_profile=@ByteArray(Default)\r\n"
        f"gamePath=@ByteArray({wine})\r\nversion=2.5.2\r\n"
        "[customExecutables]\r\nsize=1\r\n1\\title=SKSE\r\n"
        f"1\\binary={wine}\\\\skse64_loader.exe\r\n1\\arguments=\r\n1\\workingDirectory={wine}\r\n"
        "1\\steamAppID=\r\n1\\hide=false\r\n1\\ownicon=false\r\n1\\toolbar=true\r\n"
        "[Settings]\r\nstyle=vs15 Dark.qss\r\n")

    # the game
    for name in ["SkyrimSE.exe", "steam_api64.dll", "Data/Skyrim.esm", "Data/Update.esm",
                 "Data/Skyrim - Textures0.bsa", "Data/Interface/translations/skyui_english.txt",
                 "Data/textures/shared.dds", "Data/Video/BGS_Logo.bik"]:
        put(os.path.join(game, name), f"game:{name}")
        if name in PLUGINS:
            with open(os.path.join(game, name), "wb") as f:
                f.write(PLUGINS[name])

    mods = {
        "SKSE": {"Root/skse64_loader.exe": 1, "Root/skse64_1_5_97.dll": 1, "Scripts/skse.pex": 1},
        "ENB": {"root/d3d11.dll": 1, "root/enbseries.ini": 1, "root/enbseries/enbeffect.fx": 1,
                "root/Data/never-shown.txt": 1, "root/Skyrim.ini": 1},
        "Case A": {"case.esp": 1, "Textures/Shared.DDS": 1, "textures/armor/Iron.dds": 1, "MESHES/a.nif": 1},
        "Case B": {"CASE.ESP": 1, "TEXTURES/shared.dds": 1, "Textures/Armor/iron.DDS": 1, "meshes/A.NIF": 1, "meshes/b.nif": 1},
        "Deep": {"/".join(["d%02d" % i for i in range(40)]) + "/leaf.txt": 1},
        "Ünïcödé — mod": {"meshes/naïve/日本語.nif": 1, "interface/Ωmega.swf": 1, "textures/emoji 😀.dds": 1},
        "Hidden": {"plugin.esp.mohidden": 1, "visible.esp": 1, ".git/config": 1, "docs/.git/x": 1,
                   "textures/gone.dds.MOHIDDEN": 1},
        "Empty": {},
        "File over folder": {"clash": 1, "clash2/inside.txt": 1},
        "Folder over file": {"clash/inside.txt": 1, "clash2": 1},
        "Disabled": {"textures/shared.dds": 1, "disabled-only.esp": 1},
        "Unlisted": {"unlisted-only.esp": 1},
        "Case A backup1": {"backup-only.esp": 1},
        "Plugins": {"a.esp": 1, "b.esm": 1, "c.esl": 1, "d.esp": 1, "e.esp": 1, "f.esp": 1, "h.esp": 1,
                    "i.esp": 1, "late.esp": 1, "broken.esp": 1, "SKSE/Plugins/p.dll": 1, "SKSE/Plugins/p.ini": 1},
        # Conflicts (check 3): Root files of two mods, what MO2's cleanStructure drops, a mod
        # that wins nothing.
        "SKSE copy": {"Root/SKSE64_loader.exe": 1, "Root/readme.txt": 1, "Root/fomod/info.xml": 1,
                      "readme.txt": 1, "fomod/ModuleConfig.xml": 1, "docs/readme.txt": 1,
                      "plugin.esp.mohidden": 1},
        "Redundant": {"meshes/a.nif": 1, "meshes/B.nif": 1},
        "Plugins": {"a.esp": 1, "b.esm": 1, "c.esl": 1, "SKSE/Plugins/p.dll": 1, "SKSE/Plugins/p.ini": 1},
    }
    separators = ["Top_separator"] + [f"Nest {i}_separator" for i in range(1, 6)]

    names = list(mods)
    for i in range(args.files):
        mod = names[i % len(names)]
        if mod in ("Empty", "File over folder", "Folder over file", "Redundant"):
            mod = "Plugins"
        mods[mod][f"bulk/{i % 97:02d}/{i % 13}/file{i:06d}.dat"] = 1

    for mod, files in mods.items():
        os.makedirs(os.path.join(root, "mods", mod), exist_ok=True)
        put(os.path.join(root, "mods", mod, "meta.ini"), "[General]\r\nmodid=0\r\nversion=\r\n")
        for path in files:
            put(os.path.join(root, "mods", mod, path), f"{mod}:{path}")
            if path in PLUGINS:
                with open(os.path.join(root, "mods", mod, path), "wb") as f:
                    f.write(PLUGINS[path])
    for depth, sep in enumerate(separators):
        nest = f"\r\n[Plugins]\r\nSub-Separator\\nest={depth}\r\n" if depth else "\r\n"
        put(os.path.join(root, "mods", sep, "meta.ini"), "[General]\r\nmodid=0" + nest)

    # modlist.txt: the top line is the highest priority
    order = ["Folder over file", "File over folder", "Plugins", "Hidden", "Ünïcödé — mod", "Deep",
             "Nest 5_separator", "Nest 4_separator", "Nest 3_separator", "Nest 2_separator", "Nest 1_separator",
             "Case B", "Case A", "Empty", "Top_separator", "SKSE copy", "ENB", "SKSE", "Redundant"]
    lines = [HEADER] + [f"+{m}\r\n" for m in order]
    lines.insert(4, "-Disabled\r\n")
    lines.insert(6, "+Listed but gone\r\n")
    lines += ["*DLC: Dawnguard\r\n"]
    profile = os.path.join(root, "profiles", "Default")
    put(os.path.join(profile, "modlist.txt"), "".join(lines))
    listed = ["b.esm", "a.esp", "c.esl", "visible.esp", "d.esp", "f.esp", "e.esp", "h.esp", "i.esp",
              "broken.esp", "case.esp"]
    off = {"c.esl", "i.esp"}
    put(os.path.join(profile, "plugins.txt"),
        HEADER + "".join(("" if n in off else "*") + n + "\r\n" for n in listed))
    put(os.path.join(profile, "loadorder.txt"),
        HEADER + "".join(n + "\r\n" for n in ["Skyrim.esm", "Update.esm"] + listed + ["gone.esp"]))
    put(os.path.join(profile, "lockedorder.txt"), HEADER + "d.esp|4\r\n")
    put(os.path.join(profile, "settings.ini"), "[General]\r\nLocalSaves=true\r\nLocalSettings=true\r\n")
    put(os.path.join(profile, "skyrim.ini"), "[General]\r\nsLanguage=ENGLISH\r\n")
    put(os.path.join(profile, "saves", "Save 1.ess"), "save")

    put(os.path.join(root, "overwrite", "SKSE", "Plugins", "written.log"), "overwrite")
    put(os.path.join(root, "overwrite", "Root", "enbcache", "cache.bin"), "overwrite")
    put(os.path.join(root, "overwrite", "meshes", "b.nif"), "overwrite wins")
    os.makedirs(os.path.join(root, "downloads"), exist_ok=True)
    print(root)


if __name__ == "__main__":
    main()
